          if [ "${{ inputs.dry_run }}" = "true" ]; then
            echo "=== DRY RUN SNAPSHOT PREVIEW ==="
            echo "Snapshot Version: v$VERSION"
            echo "Branch Ref:       ${{ github.ref_name }}"
            echo "Git Tag:          v$VERSION"
            echo "GitHub Release:   v$VERSION (pre-release)"
