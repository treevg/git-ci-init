#!/usr/bin/env bash
set -e

# ==============================================================================
# git-ci-init
# Bootstraps a production-ready CI/CD, automated testing, SemVer versioning (via git tags),
# and release structure into any Git repository.
# Can be run directly as `git ci-init` or `ci-init`.
# ==============================================================================

show_help() {
  cat << 'EOF'
Usage: git ci-init [options] [target-directory]

Initializes a standardized CI/CD, testing, and release engineering setup
into the current (or specified) Git repository. Versioning is managed directly
via Git tags (vX.Y.Z) without redundant VERSION files.

Files bootstrapped:
  .github/workflows/ci.yml        Reusable CI caller (matrix testing & PR changelog linter)
  .github/workflows/release.yml   Reusable Release caller (SemVer release & deployment)
  .github/workflows/snapshot.yml  Reusable Snapshot caller (branch pre-release & staging deploy)
  .ci/actions/run-tests/action.yml            Project test execution hook composite action
  .ci/actions/prepare-release/action.yml      Project codebase preparation hook
  .ci/actions/deploy/action.yml               Project deployment execution hook (staging & prod)
  CHANGELOG.md                    Keep a Changelog template with ## [unreleased]

Options:
  -u, --update      Update workflows and tools without modifying CHANGELOG.md or custom actions in .ci/actions/.
  -s, --standalone  Generate self-contained, dependency-less CI (embeds release scripts locally with zero external repo dependency).
  -f, --force       Overwrite existing files if they already exist.
  -n, --dry-run     Show what files would be created without writing them.
  --version <ver>   Initial version string for tag (default: 0.1.0).
  -h, --help        Show this help message.
EOF
}

UPDATE=false
FORCE=false
DRY_RUN=false
STANDALONE=false
INITIAL_VERSION="0.1.0"
TARGET_DIR=""

while [ $# -gt 0 ]; do
  case "$1" in
    -u|--update)
      UPDATE=true
      shift
      ;;
    -s|--standalone)
      STANDALONE=true
      shift
      ;;
    -f|--force)
      FORCE=true
      shift
      ;;
    -n|--dry-run)
      DRY_RUN=true
      shift
      ;;
    --version)
      INITIAL_VERSION="$2"
      shift 2
      ;;
    -h|--help)
      show_help
      exit 0
      ;;
    *)
      if [ -z "$TARGET_DIR" ]; then
        TARGET_DIR="$1"
        shift
      else
        echo "Unknown option or extra argument: $1" >&2
        show_help
        exit 1
      fi
      ;;
  esac
done

# Resolve target directory
if [ -z "$TARGET_DIR" ]; then
  TARGET_DIR="."
fi

TARGET_DIR="$(cd "$TARGET_DIR" 2>/dev/null && pwd || { echo "Error: Directory '$TARGET_DIR' not found." >&2; exit 1; })"

# Check if target is inside a git repository
if ! git -C "$TARGET_DIR" rev-parse --is-inside-work-tree >/dev/null 2>&1; then
  echo "Warning: '$TARGET_DIR' is not a Git repository yet."
  if [ "$DRY_RUN" = false ]; then
    echo "--> Initializing git repository..."
    git -C "$TARGET_DIR" init -b main >/dev/null 2>&1 || git -C "$TARGET_DIR" init >/dev/null
  fi
fi

REPO_ROOT="$(git -C "$TARGET_DIR" rev-parse --show-toplevel 2>/dev/null || echo "$TARGET_DIR")"

echo "=== git ci-init ==="
echo "Target Repository: $REPO_ROOT"
echo "Initial Tag:       v$INITIAL_VERSION"
echo ""

if [ "$STANDALONE" = true ]; then
  FILES_TO_CREATE=(
    ".github/workflows/ci.yml"
    ".github/workflows/release.yml"
    ".github/workflows/snapshot.yml"
    ".ci/actions/run-tests/action.yml"
    ".ci/actions/prepare-release/action.yml"
    ".ci/actions/deploy/action.yml"
    ".github/scripts/release_version.py"
    "CHANGELOG.md"
  )
else
  FILES_TO_CREATE=(
    ".github/workflows/ci.yml"
    ".github/workflows/release.yml"
    ".github/workflows/snapshot.yml"
    ".ci/actions/run-tests/action.yml"
    ".ci/actions/prepare-release/action.yml"
    ".ci/actions/deploy/action.yml"
    "CHANGELOG.md"
  )
fi

echo "Files to process:"
for rel in "${FILES_TO_CREATE[@]}"; do
  full="$REPO_ROOT/$rel"
  if [ -e "$full" ]; then
    if [ "$UPDATE" = true ]; then
      if [ "$rel" = "CHANGELOG.md" ] || [[ "$rel" == .ci/actions/* ]]; then
        echo "  [preserve]  $rel (preserves custom configuration)"
      else
        echo "  [update]    $rel"
      fi
    elif [ "$FORCE" = true ]; then
      echo "  [overwrite] $rel"
    else
      echo "  [skip]      $rel (already exists, use -u to update or -f to overwrite)"
    fi
  else
    echo "  [create]    $rel"
  fi
done
echo ""

if [ "$DRY_RUN" = true ]; then
  echo "=== Dry run complete. No files were written. ==="
  exit 0
fi

# Ensure parent directories exist
mkdir -p "$REPO_ROOT/.github/workflows" "$REPO_ROOT/.ci/actions/run-tests" "$REPO_ROOT/.ci/actions/prepare-release" "$REPO_ROOT/.ci/actions/deploy"
if [ "$STANDALONE" = true ]; then
  mkdir -p "$REPO_ROOT/.github/scripts"
fi

should_write() {
  local rel="$1"
  local full_path="$REPO_ROOT/$rel"
  
  if [ "$UPDATE" = true ]; then
    if [ "$rel" = "CHANGELOG.md" ] || [[ "$rel" == .ci/actions/* ]]; then
      if [ -e "$full_path" ]; then
        return 1
      fi
    fi
    echo "--> Updating $rel..."
    return 0
  fi

  if [ -e "$full_path" ] && [ "$FORCE" = false ]; then
    return 1
  fi
  echo "--> Writing $rel..."
  return 0
}

# 1. CI Workflow
if should_write ".github/workflows/ci.yml"; then
  if [ "$STANDALONE" = true ]; then
    cat << 'EOF' > "$REPO_ROOT/.github/workflows/ci.yml"
name: 🧪 CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

jobs:
  test:
    name: Test Suite (${{ matrix.os }})
    runs-on: ${{ matrix.os }}
    strategy:
      matrix:
        os: [ubuntu-latest, macos-latest]
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4

      - name: 🧪 Run Automated Tests
        uses: ./.ci/actions/run-tests

  changelog:
    name: 📝 Lint Changelog (PR)
    runs-on: ubuntu-latest
    if: github.event_name == 'pull_request'
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0

      - name: 🔍 Verify CHANGELOG.md was updated
        run: |
          if echo "${{ github.event.pull_request.title }}" | grep -iq "\[skip changelog\]"; then
            echo "Skipping changelog check: '[skip changelog]' found in PR title."
            exit 0
          fi
          git fetch origin ${{ github.base_ref }}:refs/remotes/origin/${{ github.base_ref }} || true
          if git diff --name-only origin/${{ github.base_ref }}...HEAD | grep -q "^CHANGELOG\.md$"; then
            echo "✓ CHANGELOG.md has been modified in this pull request."
          else
            echo "::error file=CHANGELOG.md::No changes detected in CHANGELOG.md! Please document your changes under '## [unreleased]' (or include '[skip changelog]' in the PR title if exempt)."
            exit 1
          fi
EOF
  else
    cat << 'EOF' > "$REPO_ROOT/.github/workflows/ci.yml"
name: 🧪 CI

on:
  push:
    branches: [ main ]
  pull_request:
    branches: [ main ]
  workflow_dispatch:

permissions:
  contents: read

jobs:
  ci:
    uses: treevg/github-workflows/.github/workflows/ci.yml@v1
EOF
  fi
fi

# 2. Release Workflow (Official SemVer releases on main)
if should_write ".github/workflows/release.yml"; then
  if [ "$STANDALONE" = true ]; then
    cat << 'EOF' > "$REPO_ROOT/.github/workflows/release.yml"
name: 🏷️ Release

on:
  workflow_dispatch:
    inputs:
      bump:
        description: 'SemVer Version Bump'
        required: true
        default: 'patch'
        type: choice
        options:
          - patch
          - minor
          - major
      dry_run:
        description: 'Dry run (preview release without committing, tagging, or pushing)'
        required: false
        default: false
        type: boolean

permissions:
  contents: write

jobs:
  release:
    name: 🚀 Create Release & Tag
    runs-on: ubuntu-latest
    if: github.ref_name == 'main'
    steps:
      - name: 📥 Checkout repository
        uses: actions/checkout@v4
        with:
          fetch-depth: 0
          token: ${{ secrets.GITHUB_TOKEN }}

      - name: 🐍 Set up Python
        uses: actions/setup-python@v5
        with:
          python-version: '3.x'

      - name: 🔢 Bump Version & Update Changelog
        id: version_bump
        run: |
          DRY_RUN_FLAG=""
          if [ "${{ inputs.dry_run }}" = "true" ]; then
            DRY_RUN_FLAG="--dry-run"
          fi
          python3 .github/scripts/release_version.py ${{ github.event.inputs.bump }} $DRY_RUN_FLAG

      - name: 🧪 Run Automated Tests
        if: hashFiles('.ci/actions/run-tests/action.yml') != ''
        uses: ./.ci/actions/run-tests

      - name: ✏️ Prepare Release Codebase Changes
        if: ${{ inputs.dry_run != true && hashFiles('.ci/actions/prepare-release/action.yml') != '' }}
        uses: ./.ci/actions/prepare-release
        with:
          version: ${{ steps.version_bump.outputs.version }}
          is_prerelease: 'false'

      - name: 🚀 Deploy Production Release
        if: ${{ inputs.dry_run != true && hashFiles('.ci/actions/deploy/action.yml') != '' }}
        uses: ./.ci/actions/deploy
        with:
          target: production
          version: ${{ steps.version_bump.outputs.version }}

      - name: 🏷️ Commit, Tag & Push to Main
        env:
          GH_TOKEN: ${{ secrets.GITHUB_TOKEN }}
        run: |
          VERSION="${{ steps.version_bump.outputs.version }}"
          if [ -z "$VERSION" ]; then
            echo "Error: Version not set by version_bump step." >&2
            exit 1
          fi

          if [ "${{ inputs.dry_run }}" = "true" ]; then
            echo "=== DRY RUN RELEASE PREVIEW ==="
            echo "Target Version: v$VERSION"
            echo "Commit Message: chore(release): v$VERSION"
            echo "Git Tag:        v$VERSION"
            echo "Target Branch:  main"
            echo "GitHub Release: v$VERSION"
            echo "Dry run enabled: no commits, tags, or GitHub releases were published."
            exit 0
          fi

          git config user.name "github-actions[bot]"
          git config user.email "github-actions[bot]@users.noreply.github.com"
          
          echo "Releasing version: v$VERSION"
          
          git add -u
          git commit -m "chore(release): v$VERSION"
          git tag -a "v$VERSION" -m "Release v$VERSION"
          git push origin main
          git push origin "v$VERSION"

          # Create GitHub Release
          CHANGELOG_NOTES="${{ steps.version_bump.outputs.notes_path }}"
          if [ -f "$CHANGELOG_NOTES" ] && [ -s "$CHANGELOG_NOTES" ]; then
            gh release create "v$VERSION"               --title "Release v$VERSION"               --notes-file "$CHANGELOG_NOTES"
          else
            gh release create "v$VERSION"               --title "Release v$VERSION"               --generate-notes
          fi
EOF
  else
    cat << 'EOF' > "$REPO_ROOT/.github/workflows/release.yml"
name: 🏷️ Release

on:
  workflow_dispatch:
    inputs:
      bump:
        description: 'SemVer Version Bump'
        required: true
        default: 'patch'
        type: choice
        options:
          - patch
          - minor
          - major
      dry_run:
        description: 'Dry run (preview release without committing, tagging, or pushing)'
        required: false
        default: false
        type: boolean

permissions:
  contents: write

jobs:
  release:
    uses: treevg/github-workflows/.github/workflows/release.yml@v1
    with:
      bump: ${{ inputs.bump }}
      dry_run: ${{ inputs.dry_run }}
    secrets: inherit
EOF
  fi
fi

