on:
  workflow_dispatch:
    inputs:
      run_tests:
        description: 'Run automated test suite before pre-release'
        required: false
        default: true
        type: boolean
      dry_run:
        description: 'Dry run (preview snapshot version without committing, tagging, or pushing)'
